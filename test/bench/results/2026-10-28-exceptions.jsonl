{"kind":"isolated-probe-source","description":"Exploratory constructor-only diagnostic; the scaling suite now contains equivalent cases using its common measurement helper. Stack frames differ between harnesses, so do not compare absolute timings across them.","source":"import assert from 'node:assert/strict';\nimport { Message, Server, Struct, CapnpRpcError } from '/home/michael/p/personal/capnp-es/dist/index.mjs';\nimport { Exception } from '/home/michael/p/personal/capnp-es/dist/capnp/rpc.mjs';\nconst method = { ParamsClass: Struct, ResultsClass: Struct, interfaceId: 1n, methodId: 0, interfaceName: 'test/bench/data/sandstorm/workloads.capnp:Bench', methodName: 'ping' };\nlet Constructor;\ntry { new Server({}, []).call({method}).struct(); }\ncatch (error) { assert(error instanceof CapnpRpcError); Constructor = error.constructor; }\nassert(Constructor);\nconst message = new Message();\nconst exception = message.initRoot(Exception);\nexception.reason = 'expected context.getParams().getSequence() != 0xffffffffu [4294967295 != 4294967295]; forced benchmark failure';\nmessage._capnp.traversalLimit = 0x3fffffff;\nfor (const stack of [false, true]) {\n const operation = () => {\n   const error = new Constructor(method, exception);\n   return stack ? error.stack.length : String(error).length;\n };\n const expected = operation();\n const until = performance.now() + 1000;\n while (performance.now() < until) for(let i=0; i<1000; i++) operation();\n const samplesUs=[];\n let result;\n for (let sample=0; sample<7; sample++) {\n   const start=performance.now();\n   for(let i=0; i<20000; i++) result=operation();\n   samplesUs.push((performance.now()-start)*1000/20000);\n }\n assert(result>0);\n console.log(JSON.stringify({ name: `MethodError construction${stack?' + stack access':''}`, samplesUs, medianUs:[...samplesUs].sort((a,b)=>a-b)[3], expected, result }));\n}\n"}
